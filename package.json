{
  "name": "mirefir",
  "private": true,
  "version": "1.0.0",
  "author": "MirEfir",
  "description": "IPTV player for Windows, Linux and Android",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "cap:sync": "vite build && npx cap sync",
    "android:open": "npx cap open android",
    "android:apk": "vite build && npx cap sync && cd android && .\\gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.1.0",
    "@capacitor/core": "^7.4.3",
    "@capacitor/status-bar": "^7.0.3",
    "hls.js": "^1.6.13",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "tailwindcss": "^4.1.13",
    "@tailwindcss/vite": "^4.1.13",
    "vite": "^7.1.5",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.mirefir.app",
    "productName": "MirEfir",
    "directories": {
      "output": "C:/Users/Sasha/MirEfir-release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-${version}-windows.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "tar.gz"
      ],
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "category": "AudioVideo",
      "synopsis": "Premium IPTV player"
    }
  }
}
